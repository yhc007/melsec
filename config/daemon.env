# MELSEC PLC Daemon 환경 설정

# PLC 연결 설정
PLC_IP=192.168.21.112
PLC_PORT=5010

# Kafka 설정
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=melsec-plc-data-1

# 읽기 설정
# D1000~D1016 (17워드) 배치 읽기
START_ADDRESS=1000
READ_COUNT=17
READ_INTERVAL_MS=1000

# 로그 레벨 (error, warn, info, debug, trace)
RUST_LOG=info

# 패킷 hex 트레이스를 packet_debug.log(WorkingDirectory 기준)에 기록할지 여부.
# 기본값은 꺼짐. 문제 진단 시에만 1로 켜고, 끝나면 반드시 되돌릴 것
# (초당 4회 append 라 파일이 빠르게 커진다).
#PACKET_TRACE=1
