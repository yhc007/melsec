# MELSEC PLC Daemon 환경 설정 (인스턴스 2 — 192.168.21.114)

# PLC 연결 설정
PLC_IP=192.168.21.114
PLC_PORT=5010

# Kafka 설정
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=melsec-plc-data-2

# 읽기 설정
# D1000~D1016 (17워드) 배치 읽기 — 1호기와 동일 범위
# (7워드였을 때는 D1008 이상이 없어 대시보드 라인 2에 스케일/RPM이 표시되지 않았음)
START_ADDRESS=1000
READ_COUNT=17
READ_INTERVAL_MS=1000

# 로그 레벨 (error, warn, info, debug, trace)
RUST_LOG=info
