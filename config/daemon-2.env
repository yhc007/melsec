# MELSEC PLC Daemon 환경 설정 (인스턴스 2 — 192.168.21.114)

# PLC 연결 설정
PLC_IP=192.168.21.114
PLC_PORT=5010

# Kafka 설정
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=melsec-plc-data-2

# 읽기 설정
# D1000~D1006 (7워드) 배치 읽기 — 요청 주소 D1000, D1002, D1004, D1006 모두 포함
START_ADDRESS=1000
READ_COUNT=7
READ_INTERVAL_MS=1000

# 로그 레벨 (error, warn, info, debug, trace)
RUST_LOG=info
